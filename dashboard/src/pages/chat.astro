---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import TopBar from '../components/TopBar.astro';

const repositories = [
  {
    name: 'AlphaFX Main',
    description: 'Primary application repository and coding-agent workspace.',
    url: 'https://github.com/nexxwalker/alphafxmain',
    accent: 'var(--color-accent)',
  },
  {
    name: 'Peon Deployment & Development',
    description: 'Deployment setup and development workflow for the agent runtime.',
    url: 'https://github.com/nexxwalker/Peon-deployment-and-development',
    accent: '#f59e0b',
  },
];
---

<DashboardLayout
  title="Chat workspace — Emberspack Inc."
  description="Connect your repositories and prepare a coding-agent workflow in one Emberspack workspace."
>
  <TopBar />
  <main class="mx-auto w-full max-w-[1180px] px-5 py-6 sm:px-8 lg:px-10">
    <div class="mb-8 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/10 px-3 py-1 font-ui-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
          Chat workspace
        </div>
        <h1 class="text-3xl font-semibold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">Connect the workflow before adding an agent.</h1>
        <p class="mt-3 max-w-2xl text-[15px] leading-7 text-[var(--color-text-secondary)]">Bring your application and deployment repositories into one reviewable setup. Once the connection is ready, add a coding agent without losing the context of either project.</p>
      </div>
      <a href="https://github.com/nexxwalker/Peon-deployment-and-development" target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-[var(--color-text-primary)] px-4 py-2.5 text-[13px] font-semibold text-[var(--color-surface-0)] transition hover:opacity-90">
        Open deployment setup
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <section class="grid gap-4 lg:grid-cols-2" aria-label="Connected repositories">
      {repositories.map((repository, index) => (
        <article class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-1)] p-5 shadow-sm transition hover:border-[var(--color-accent)]/40">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-2)]" style={`color:${repository.accent}`}>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg>
              </span>
              <div>
                <h2 class="text-[15px] font-semibold text-[var(--color-text-primary)]">{repository.name}</h2>
                <p class="mt-1 text-[13px] leading-5 text-[var(--color-text-secondary)]">{repository.description}</p>
              </div>
            </div>
            <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-1 font-ui-mono text-[10px] font-semibold uppercase tracking-wider text-emerald-400">Ready</span>
          </div>
          <div class="mt-5 flex items-center justify-between gap-3 border-t border-[var(--color-border)] pt-4">
            <code class="min-w-0 truncate text-[11px] text-[var(--color-text-tertiary)]">{repository.url.replace('https://github.com/', '')}</code>
            <a href={repository.url} target="_blank" rel="noopener noreferrer" class="shrink-0 text-[12px] font-semibold text-[var(--color-accent)] hover:underline">Review repo ↗</a>
          </div>
        </article>
      ))}
    </section>

    <section class="mt-8 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-1)] p-5 sm:p-6" aria-labelledby="workflow-heading">
      <div class="flex flex-col gap-3 border-b border-[var(--color-border)] pb-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 id="workflow-heading" class="text-lg font-semibold text-[var(--color-text-primary)]">Agent setup workflow</h2>
          <p class="mt-1 text-[13px] text-[var(--color-text-secondary)]">A single handoff path from repository context to a coding agent.</p>
        </div>
        <span class="font-ui-mono text-[11px] text-[var(--color-text-tertiary)]">2 repositories connected</span>
      </div>
      <ol class="mt-6 grid gap-5 md:grid-cols-3">
        <li class="relative md:pr-5">
          <span class="mb-3 flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-accent)] font-ui-mono text-[12px] font-bold text-[var(--color-surface-0)]">1</span>
          <h3 class="text-[14px] font-semibold text-[var(--color-text-primary)]">Review application context</h3>
          <p class="mt-1.5 text-[13px] leading-6 text-[var(--color-text-secondary)]">Start with AlphaFX Main as the source of product code, conventions, and current implementation.</p>
        </li>
        <li class="relative md:border-l md:border-[var(--color-border)] md:pl-5 md:pr-5">
          <span class="mb-3 flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-accent)] font-ui-mono text-[12px] font-bold text-[var(--color-surface-0)]">2</span>
          <h3 class="text-[14px] font-semibold text-[var(--color-text-primary)]">Connect deployment context</h3>
          <p class="mt-1.5 text-[13px] leading-6 text-[var(--color-text-secondary)]">Use the Peon setup repository to establish deployment, development, and runtime expectations.</p>
        </li>
        <li class="relative md:border-l md:border-[var(--color-border)] md:pl-5">
          <span class="mb-3 flex h-8 w-8 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] font-ui-mono text-[12px] font-bold text-[var(--color-text-primary)]">3</span>
          <h3 class="text-[14px] font-semibold text-[var(--color-text-primary)]">Add coding agent</h3>
          <p class="mt-1.5 text-[13px] leading-6 text-[var(--color-text-secondary)]">When both repositories are reviewed, attach an agent to the connected workflow and begin implementation.</p>
        </li>
      </ol>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-dashed border-[var(--color-accent)]/40 bg-[var(--color-accent)]/5 px-4 py-3">
        <div class="flex items-center gap-2 text-[13px] text-[var(--color-text-secondary)]"><span class="h-2 w-2 rounded-full bg-amber-400"></span>Agent slot is ready after repository review.</div>
        <a href="https://github.com/nexxwalker/alphafxmain" target="_blank" rel="noopener noreferrer" class="text-[12px] font-semibold text-[var(--color-accent)] hover:underline">Start with AlphaFX Main ↗</a>
      </div>
    </section>
  </main>
</DashboardLayout>
